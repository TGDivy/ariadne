# Copy this file to .env and fill in the values below.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numerical Telegram user ID.
TELEGRAM_ALLOWED_USER_ID=

# The name Iris calls you by. Substituted into her instructions.
ARIADNE_HUMAN_NAME=

# Local clone of The Thread, Ariadne’s private Git-backed vault.
ARIADNE_VAULT=~/ariadne-thread

# Ariadne applies these Codex settings explicitly. You can change them for a
# running process through Telegram with /settings.
ARIADNE_CODEX_MODEL=gpt-5.6-luna
ARIADNE_REASONING_EFFORT=low

# Use "live" only when Ariadne should be able to research current information.
ARIADNE_WEB_SEARCH=disabled

# Optional. Set any of these and run `python -m ariadne.bot_profile` once to
# apply them to the bot itself, independent of the running process.
ARIADNE_BOT_NAME=
ARIADNE_BOT_DESCRIPTION=
ARIADNE_BOT_SHORT_DESCRIPTION=
ARIADNE_BOT_PROFILE_PHOTO=
