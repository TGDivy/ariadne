# Copy this file to .env and fill in the values below.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numerical Telegram user ID.
TELEGRAM_ALLOWED_USER_ID=

# Directory Codex may inspect, edit, and run commands in.
# "." means this Ariadne checkout when run from the repository root.
ARIADNE_WORKSPACE=.
