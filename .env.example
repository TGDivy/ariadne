# Copy this file to .env and fill in the values below.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numerical Telegram user ID.
TELEGRAM_ALLOWED_USER_ID=

# Local clone of The Thread, Ariadne’s private Git-backed vault.
ARIADNE_VAULT=~/ariadne-thread

# Ariadne applies these Codex settings explicitly. You can change them for a
# running process through Telegram with /settings.
ARIADNE_CODEX_MODEL=gpt-5.6-sol
ARIADNE_REASONING_EFFORT=medium

# Use "live" only when Ariadne should be able to research current information.
ARIADNE_WEB_SEARCH=disabled
