# Copy this file to .env and fill in the values below.

# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numerical Telegram user ID.
TELEGRAM_ALLOWED_USER_ID=

# Local clone of The Thread, Ariadne’s private Git-backed vault.
ARIADNE_VAULT=~/ariadne-thread

# Ariadne applies these Codex settings explicitly. You can change them for a
# running process through Telegram with /settings.
ARIADNE_CODEX_MODEL=gpt-5.6-luna
ARIADNE_REASONING_EFFORT=low

# Use "live" only when Ariadne should be able to research current information.
ARIADNE_WEB_SEARCH=disabled

# Run `uv run --env-file .env ariadne-webhook` for GitHub-triggered Codex turns.
ARIADNE_GITHUB_WEBHOOK_SECRET=
ARIADNE_GITHUB_WEBHOOK_REPOSITORIES=TGDivy/nonce,TGDivy/learning-workspace
ARIADNE_GITHUB_WEBHOOK_HOST=127.0.0.1
ARIADNE_GITHUB_WEBHOOK_PORT=8787
