# Copy this file to .env and fill in the values below.

# Telegram ────────────────────────────────────────────────────────────────────

# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numerical Telegram user ID — the only account Ariadne will answer to.
# Message @userinfobot to get it.
TELEGRAM_ALLOWED_USER_ID=

# Iris ────────────────────────────────────────────────────────────────────────

# The name Iris calls you by. Substituted into her instructions.
ARIADNE_HUMAN_NAME=

# Local clone of The Thread, Ariadne’s private Git-backed vault.
ARIADNE_VAULT=~/ariadne-thread

# Codex ───────────────────────────────────────────────────────────────────────

# Ariadne applies these explicitly. Change them for a running process
# through Telegram with /settings.
ARIADNE_CODEX_MODEL=gpt-5.6-luna
ARIADNE_REASONING_EFFORT=low

# Use "live" only when Ariadne should be able to research current information.
ARIADNE_WEB_SEARCH=disabled

# Bot profile (optional) ──────────────────────────────────────────────────────
#
# Telegram shows these on the bot account itself, independent of the running
# process. Apply them once with `python -m ariadne.bot_profile`, and again
# only when one of them should change. Leave any of them blank to leave that
# part of the bot's profile as it already is.

# Up to 64 characters.
ARIADNE_BOT_NAME=Iris

# Shown in the chat with the bot before the first message. Up to 512 characters.
ARIADNE_BOT_DESCRIPTION=The other half of a two-person crew, not an assistant you own.

# Shown on the bot's profile page and when it's shared. Up to 120 characters.
ARIADNE_BOT_SHORT_DESCRIPTION=Your other half, reachable here.

# Local path to a .jpg for the bot's avatar.
ARIADNE_BOT_PROFILE_PHOTO=
